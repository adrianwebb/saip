# Copy to terraform.tfvars and fill in. NEVER commit real values or the API key.
# The Hyperstack provider authenticates via the API_KEY environment variable:
#   export API_KEY=your-hyperstack-api-key

region           = "CANADA-1"
environment_name = "saip-prod"
keypair_name     = "saip-keypair"
image_name       = "Ubuntu Server 22.04 LTS R535 CUDA 12.2 with Docker"
inference_flavor = "n3-H100x1"
training_flavor  = "n3-H100x1"
