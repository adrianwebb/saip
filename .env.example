# SAIP Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ─── Cloudflare R2 ───────────────────────────────────────────
# S3-compatible object storage for adapters, knowledge, sessions, feedback
SAIP_R2_BUCKET=saip-platform
SAIP_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
SAIP_R2_ACCESS_KEY_ID=your-r2-access-key-id
SAIP_R2_SECRET_ACCESS_KEY=your-r2-secret-access-key

# ─── HuggingFace Hub ────────────────────────────────────────
# Token for downloading base models (Qwen3.5-4B, etc.)
SAIP_HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Hyperstack (optional) ──────────────────────────────────
# Only needed if deploying to remote GPU nodes
# SAIP_HYPERSTACK_API_KEY=your-hyperstack-api-key
# SAIP_HYPERSTACK_ENVIRONMENT=your-environment-name

# ─── Service Ports (optional overrides) ─────────────────────
# SAIP_INFERENCE_PORT=8000
# SAIP_TRAINING_PORT=8001
