---
/**
 * Download the SAIP CLI (#123, refined in #132 for a first-time user).
 *
 * Reading this as a person rather than as the author: pick your platform, then copy the commands.
 * Everything else — release-availability caveats, cross-platform footnotes, instructions addressed
 * to no one in particular — belongs in the CLI reference, not in the getting-started path.
 *
 * The commands shown match the platform in focus, so a Mac visitor never reads a Windows note and a
 * Windows visitor never sees `chmod`. Colours come from Starlight's own green tokens (`-low` is the
 * interior, `-high` the foreground, `--sl-color-green` the frame), which invert correctly between the
 * light and dark themes instead of a hard-coded green that would only suit one of them.
 */
import { Icon } from '@astrojs/starlight/components'

const BASE = 'https://github.com/adrianwebb/saip/releases/latest/download'

type Target = {
  id: string
  label: string
  file: string
  icon: 'linux' | 'apple' | null
  steps: string[]
  note?: string
}

const UNIX_STEPS = (file: string): string[] => [
  `curl -fLO ${BASE}/${file}`,
  `curl -fLO ${BASE}/SHA256SUMS`,
  'sha256sum -c SHA256SUMS --ignore-missing',
  `chmod +x ${file}`,
  `sudo mv ${file} /usr/local/bin/saip`,
  'saip --version',
]

const MAC_NOTE = 'The first time you run it, macOS may say the developer cannot be verified. Open System Settings → Privacy & Security and click “Open Anyway”.'

const targets: Target[] = [
  { id: 'linux-x64', label: 'Linux · x86-64', file: 'saip-linux-x64', icon: 'linux', steps: UNIX_STEPS('saip-linux-x64') },
  { id: 'linux-arm64', label: 'Linux · ARM64', file: 'saip-linux-arm64', icon: 'linux', steps: UNIX_STEPS('saip-linux-arm64') },
  {
    id: 'darwin-arm64', label: 'macOS · Apple Silicon', file: 'saip-darwin-arm64', icon: 'apple',
    steps: UNIX_STEPS('saip-darwin-arm64'),
    note: MAC_NOTE,
  },
  {
    id: 'darwin-x64', label: 'macOS · Intel', file: 'saip-darwin-x64', icon: 'apple',
    steps: UNIX_STEPS('saip-darwin-x64'),
    note: MAC_NOTE,
  },
  {
    id: 'windows-x64', label: 'Windows · x86-64', file: 'saip-windows-x64.exe', icon: null,
    steps: [
      `curl.exe -LO ${BASE}/saip-windows-x64.exe`,
      `curl.exe -LO ${BASE}/SHA256SUMS`,
      'Get-FileHash .\\saip-windows-x64.exe -Algorithm SHA256',
      '.\\saip-windows-x64.exe --version',
    ],
    note: 'Compare the hash printed by Get-FileHash with the saip-windows-x64.exe line in SHA256SUMS (it is lowercase in the file).',
  },
]

// Static default = the common server case, so the block still reads correctly with JS disabled.
const fallback = targets[0]

const esc = (s: string): string => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
---
<div class="dl" data-base={BASE}>
  <ul class="dl-grid">
    {targets.map((t) => (
      <li class="dl-item" data-id={t.id}>
        <a class="dl-btn" href={`${BASE}/${t.file}`} rel="noopener" data-label={t.label}>
          <span class="dl-icon" aria-hidden="true">
            {t.icon ? <Icon name={t.icon} size="1.35rem" /> : (
              <svg viewBox="0 0 16 16" width="19" height="19" fill="currentColor" aria-hidden="true">
                <path d="M0 2.2 6.6 1.1v6.2H0zM7.4.95 16-.25v7.55H7.4zM0 8.1h6.6v6.2L0 13.2zM7.4 8.1H16v7.55l-8.6-1.2z"/>
              </svg>
            )}
          </span>
          <span class="dl-label">{t.label}</span>
          <Icon name="download" size="1rem" class="dl-dl" />
        </a>
      </li>
    ))}
  </ul>

  <p class="dl-detected" id="dl-detected" hidden>Detected your platform: <strong></strong></p>

  <div class="dl-steps" id="dl-steps" data-default={fallback.id}>
    <!-- Rendered statically for the default target so the page is usable without JavaScript; the
         script replaces it when a platform is detected or another button is chosen. -->
    <pre><code>{targets.map((t) => t.id === fallback.id ? t.steps.map(esc).join('\n') : '').filter(Boolean).join('\n')}</code></pre>
    <p class="dl-note" id="dl-note" hidden></p>
  </div>
</div>

<script define:vars={{ targets }}>
  const stepsBox = document.getElementById('dl-steps')
  const noteEl = document.getElementById('dl-note')
  const detected = document.getElementById('dl-detected')
  const detectedName = detected?.querySelector('strong')

  const render = (id) => {
    const t = targets.find((x) => x.id === id)
    if (!t || !stepsBox) return
    stepsBox.querySelector('pre code')!.textContent = t.steps.join('\n')
    stepsBox.dataset.active = t.id
    if (noteEl) {
      if (t.note) { noteEl.textContent = t.note; noteEl.hidden = false }
      else { noteEl.textContent = ''; noteEl.hidden = true }
    }
    document.querySelectorAll('.dl-item').forEach((li) => {
      li.classList.toggle('is-active', li.dataset.id === t.id)
    })
  }

  // Which platform are we on? A convenience, never a lock: picking any button above replaces both the
  // commands and the note immediately.
  const ua = navigator.userAgent
  let chosen = null
  if (/Windows/.test(ua)) chosen = 'windows-x64'
  else if (/Macintosh|Mac OS X/.test(ua)) {
    // Safari and Chrome both report "Intel Mac OS X" on Apple Silicon, and `navigator.architecture`
    // does not exist — so a UA-based guess here would be wrong on nearly every Mac sold since 2021.
    // Default to Apple Silicon and let the async client-hints answer refine it where supported.
    chosen = 'darwin-arm64'
    const hints = (navigator as unknown as { userAgentData?: { getHighEntropyValues?(k: string[]): Promise<{ architecture?: string }> } }).userAgentData
    hints?.getHighEntropyValues?.(['architecture']).then((v) => {
      if (v?.architecture && /x86/i.test(v.architecture)) {
        if (chosen === 'darwin-arm64') { chosen = 'darwin-x64'; render('darwin-x64') }
        if (detectedName && detected && !detected.hidden && /macOS/i.test(detectedName.textContent ?? '')) {
          detectedName.textContent = 'macOS · Intel'
        }
      }
    }).catch(() => { /* client hints unavailable: the Apple Silicon default stands */ })
  }
  else if (/Linux/.test(ua)) chosen = /arm64|aarch64/.test(ua) ? 'linux-arm64' : 'linux-x64'

  if (chosen) {
    const t = targets.find((x) => x.id === chosen)
    if (t && detected && detectedName) { detectedName.textContent = t.label; detected.hidden = false }
  }
  render(chosen ?? stepsBox?.dataset.default ?? 'linux-x64')

  // A download button also selects its platform, so the commands underneath are the right ones for
  // what you just downloaded. The link still downloads; this only updates the page.
  document.querySelectorAll('.dl-btn').forEach((a) => {
    a.addEventListener('click', () => {
      const id = a.closest('.dl-item')?.dataset.id
      if (id) render(id)
    })
  })
</script>

<style>
  .dl { margin: 1.5rem 0; }
  .dl-grid { list-style: none; padding: 0; margin: 0 0 .9rem; display: grid; gap: .55rem; grid-template-columns: repeat(auto-fit, minmax(13.5rem, 1fr)); }
  .dl-btn { display: flex; align-items: center; gap: .55rem; padding: .6rem .8rem; border: 1px solid var(--sl-color-gray-5); border-radius: .5rem; text-decoration: none; background: var(--sl-color-gray-6); color: var(--sl-color-white); }
  .dl-btn:hover { border-color: var(--sl-color-green); }
  .is-active .dl-btn { border-color: var(--sl-color-green); box-shadow: 0 0 0 1px var(--sl-color-green); }
  .dl-icon { display: inline-flex; }
  .dl-label { font-weight: 600; font-size: .92rem; }
  .dl-dl { margin-inline-start: auto; opacity: .65; }
  .dl-detected { margin: 0 0 .55rem; font-size: .95rem; }
  /* Starlight's green tokens: `-low` is the interior, `-high` the foreground, `-green` the frame.
     They swap with the theme, so this is a green panel in both modes without a second value. */
  .dl-steps { border: 1px solid var(--sl-color-green); background: var(--sl-color-green-low); border-radius: .5rem; padding: .2rem .9rem .5rem; }
  .dl-steps pre { margin: .5rem 0 0; background: transparent; padding: 0; }
  .dl-steps code { color: var(--sl-color-green-high); font-size: .9rem; background: transparent; }
  .dl-note { margin: .6rem 0 0; font-size: .86rem; color: var(--sl-color-green-high); }
</style>
