{
  "name": "@saip/cli",
  "version": "0.6.2",
  "description": "SAIP CLI \u2014 manage inference and training services",
  "type": "module",
  "bin": {
    "saip": "dist/bin.js"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && node scripts/mark-bin-executable.mjs",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "install:local": "node scripts/install-link.mjs",
    "build:bin": "node scripts/build-binaries.mjs",
    "build:bin:all": "node scripts/build-binaries.mjs --all",
    "install:dev": "node scripts/install-dev.mjs"
  },
  "dependencies": {
    "@saip/shared": "workspace:*",
    "commander": "^13.0.0",
    "cordis": "^4.0.0-rc.11",
    "dotenv": "^16.4.0",
    "ink": "8.0.0",
    "react": "19.3.1",
    "react-devtools-core": "^6.1.5",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "scripts"
  ]
}
